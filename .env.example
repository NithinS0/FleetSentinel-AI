# ─────────────────────────────────────────────────────────────────
# FleetSentinel AI — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=your_super_secret_key_at_least_32_characters_long

# ─── Database ────────────────────────────────────────────────────
POSTGRES_DB=fleetsentinel
POSTGRES_USER=fleetsentinel
POSTGRES_PASSWORD=fleetsentinel_secret

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ─── Simulator ───────────────────────────────────────────────────
VEHICLE_COUNT=100000
EVENTS_PER_SECOND=100000
SIMULATOR_MODE=realistic          # realistic | burst | fault_heavy
FAULT_INJECTION_RATE=0.05         # 5% of vehicles have faults

# ─── AI / LLM ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key   # optional fallback

# ─── Frontend ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_COPILOT_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8000

# ─── Observability ───────────────────────────────────────────────
GRAFANA_PASSWORD=fleetsentinel
